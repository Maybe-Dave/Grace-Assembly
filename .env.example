# =============================================================================
# Grace Assembly Church Management App — Environment Variables
# =============================================================================
# Copy this file to .env.local for local development.
# In Vercel: add every variable below to Project Settings → Environment Variables.
# NEVER commit .env.local or any file containing real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE (required — app will not start without these)
# -----------------------------------------------------------------------------

# Your Supabase project URL (e.g. https://xvnussqofsdyffypiulp.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# Supabase anon/public key — safe to expose to the browser (RLS enforces security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase service role key — SERVER ONLY, never expose to browser.
# Used by API routes to bypass RLS for admin operations.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# -----------------------------------------------------------------------------
# DEVELOPMENT ONLY — DO NOT SET IN PRODUCTION/VERCEL
# -----------------------------------------------------------------------------

# Set to "true" only in local .env.local to enable the dev quick-login toolbar
# and the /api/auth/dev-login endpoint. Leave unset (or set to "false") in Vercel.
# NEXT_PUBLIC_ENABLE_DEV_LOGIN=true

# =============================================================================
# VERCEL DASHBOARD CHECKLIST (set these before first deploy)
# =============================================================================
# Required (production will crash without these):
#   NEXT_PUBLIC_SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY
#   SUPABASE_SERVICE_ROLE_KEY
#
# Optional (must NOT be set in Vercel for security):
#   NEXT_PUBLIC_ENABLE_DEV_LOGIN  — omit entirely in production
# =============================================================================
